{
  "Comment": "Manara Serverless Image Processing Workflow",
  "StartAt": "ValidateImage",
  "States": {
    "ValidateImage": {
      "Type": "Task",
      "Resource": "arn:aws:states:::lambda:invoke",
      "OutputPath": "$.Payload",
      "Parameters": {
        "Payload.$": "$",
        "FunctionName": "arn:aws:lambda:eu-central-1:243745688077:function:validate-image:$LATEST"
      },
      "Retry": [
        {
          "ErrorEquals": [
            "Lambda.ServiceException",
            "Lambda.AWSLambdaException",
            "Lambda.SdkClientException",
            "Lambda.TooManyRequestsException"
          ],
          "IntervalSeconds": 1,
          "MaxAttempts": 3,
          "BackoffRate": 2,
          "JitterStrategy": "FULL"
        }
      ],
      "Next": "ReadyForProcessing"
    },
    "ReadyForProcessing": {
      "Type": "Pass",
      "Result": {
        "status": "READY_FOR_PROCESSING",
        "message": "Image validation completed successfully"
      },
      "End": true
    }
  },
  "QueryLanguage": "JSONPath"
}
